#!/bin/sh
# Reject commit messages that do not follow Conventional Commits.
msg_file="$1"
header="$(head -n1 "$msg_file")"

# type(scope): description   |   type: description
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'

if printf '%s' "$header" | grep -Eq "$pattern"; then
  exit 0
fi

echo "commit-msg hook: rejected non-conventional commit message:" >&2
echo "  $header" >&2
echo "expected: type(scope): imperative description" >&2
exit 1
